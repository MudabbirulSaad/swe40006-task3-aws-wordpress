{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Task 3 isolated network, private artifacts, roles and initial local WordPress",
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.43.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-vpc"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-igw"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-public-routes"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PrivateRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-private-routes"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "PublicA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.43.1.0/24",
        "AvailabilityZone": "ap-southeast-2a",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-publica"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "PublicARoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicA"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PublicB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.43.2.0/24",
        "AvailabilityZone": "ap-southeast-2b",
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-publicb"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "PublicBRoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicB"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "PrivateA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.43.11.0/24",
        "AvailabilityZone": "ap-southeast-2a",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-privatea"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "PrivateARoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateA"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    },
    "PrivateB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.43.12.0/24",
        "AvailabilityZone": "ap-southeast-2b",
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-privateb"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      }
    },
    "PrivateBRoutes": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateB"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes"
        }
      }
    },
    "PassSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Pass web access and SSH only from the task operator IP",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-pass-sg"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ],
        "SecurityGroupIngress": []
      }
    },
    "AlbSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Public HTTP entry point",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-alb-sg"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "WebSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Backend HTTP from ALB only; no SSH",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-web-sg"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourceSecurityGroupId": {
              "Ref": "AlbSG"
            }
          }
        ]
      }
    },
    "DbSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Database from task application groups only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-db-sg"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ],
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3306,
            "ToPort": 3306,
            "SourceSecurityGroupId": {
              "Ref": "WebSG"
            }
          }
        ]
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "swe40006-t3-783161929831-artifacts",
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-artifacts"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "PassRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "swe40006-t3-pass-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "TaskArtifactsAndConfiguration",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    "arn:aws:s3:::swe40006-t3-783161929831-artifacts/backups/*",
                    "arn:aws:s3:::swe40006-t3-783161929831-artifacts/releases/*",
                    "arn:aws:s3:::swe40006-t3-783161929831-artifacts/evidence/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": [
                    "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/runtime/wp-config",
                    "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/migration/db-master"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:PutParameter",
                  "Resource": "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/runtime/wp-config"
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                    "ssm:GetParametersByPath"
                  ],
                  "NotResource": [
                    "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/runtime/wp-config",
                    "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/migration/db-master"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "PassRoleProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "InstanceProfileName": "swe40006-t3-pass-profile",
        "Roles": [
          {
            "Ref": "PassRole"
          }
        ]
      }
    },
    "WebRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "swe40006-t3-web-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "TaskArtifactsAndConfiguration",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    "arn:aws:s3:::swe40006-t3-783161929831-artifacts/releases/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetParameter",
                  "Resource": [
                    "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/runtime/wp-config"
                  ]
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters",
                    "ssm:GetParametersByPath"
                  ],
                  "NotResource": [
                    "arn:aws:ssm:ap-southeast-2:783161929831:parameter/swe40006/t3/runtime/wp-config"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "WebRoleProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "InstanceProfileName": "swe40006-t3-web-profile",
        "Roles": [
          {
            "Ref": "WebRole"
          }
        ]
      }
    },
    "PassLaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateName": "swe40006-t3-pass-template",
        "LaunchTemplateData": {
          "ImageId": "ami-0fe65665c4d6f0de7",
          "InstanceType": "t3.micro",
          "KeyName": "swe40006-t3-pass-key",
          "SecurityGroupIds": [
            {
              "Ref": "PassSG"
            }
          ],
          "IamInstanceProfile": {
            "Name": {
              "Ref": "PassRoleProfile"
            }
          },
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpEndpoint": "enabled"
          },
          "CreditSpecification": {
            "CpuCredits": "standard"
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 12,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ],
          "UserData": ""
        }
      }
    },
    "PassInstance": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "LaunchTemplate": {
          "LaunchTemplateId": {
            "Ref": "PassLaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "PassLaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        },
        "SubnetId": {
          "Ref": "PublicA"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "swe40006-t3-pass"
          },
          {
            "Key": "Project",
            "Value": "swe40006-t3"
          }
        ]
      },
      "DependsOn": "InternetRoute"
    }
  },
  "Outputs": {
    "Vpc": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "PublicA": {
      "Value": {
        "Ref": "PublicA"
      }
    },
    "PublicB": {
      "Value": {
        "Ref": "PublicB"
      }
    },
    "PrivateA": {
      "Value": {
        "Ref": "PrivateA"
      }
    },
    "PrivateB": {
      "Value": {
        "Ref": "PrivateB"
      }
    },
    "PassSG": {
      "Value": {
        "Ref": "PassSG"
      }
    },
    "AlbSG": {
      "Value": {
        "Ref": "AlbSG"
      }
    },
    "WebSG": {
      "Value": {
        "Ref": "WebSG"
      }
    },
    "DbSG": {
      "Value": {
        "Ref": "DbSG"
      }
    },
    "PassInstance": {
      "Value": {
        "Ref": "PassInstance"
      }
    },
    "WebRoleProfile": {
      "Value": {
        "Ref": "WebRoleProfile"
      }
    },
    "PassRoleProfile": {
      "Value": {
        "Ref": "PassRoleProfile"
      }
    },
    "Bucket": {
      "Value": {
        "Ref": "Artifacts"
      }
    }
  }
}